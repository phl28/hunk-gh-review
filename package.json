{
  "name": "hunk-gh-review",
  "version": "0.1.0",
  "description": "Hunk extension: submit review notes as a GitHub PR review",
  "license": "MIT",
  "repository": "github:phl28/hunk-gh-review",
  "hunk": {
    "extensions": [
      "./dist/index.js"
    ],
    "apiVersion": 6
  },
  "devDependencies": {
    "@opentui/core": "^0.5.4",
    "@opentui/react": "^0.5.4",
    "@types/hast": "3.0.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "hunkdiff": "^0.19.0",
    "react": "^19.2.8",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "postinstall": "bun scripts/build.mjs",
    "test": "pnpm run build && bun test pr-discovery.test.ts comment-markdown.test.ts && bun test thread-pane.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "rehype-raw": "7.0.0",
    "rehype-remark": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5"
  }
}
